# Chỉ đặt secrets trong server/.env; không đặt vào EXPO_PUBLIC_*.
PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster>/QLHocPhan?retryWrites=true&w=majority
# DNS công cộng chỉ cho tiến trình Node backend (truy vấn Atlas SRV/TXT).
# Để trống nếu muốn dùng DNS hệ thống. Không liên quan IP Access List của Atlas.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Sinh bằng: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_MINUTES=60
ADMIN_USERNAME=
# Mật khẩu admin riêng cho ứng dụng, ít nhất 8 ký tự, tối đa 72 byte UTF-8.
# Đặt trong dấu nháy đơn; chỉ lưu ở backend, không đưa vào frontend/Git.
ADMIN_PASSWORD=''
# Danh sách origin web, phân cách bằng dấu phẩy; thêm origin IP LAN khi dùng web qua LAN.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
